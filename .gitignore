# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# 비밀값 — 공개 포트폴리오 repo이므로 어떤 경우에도 커밋 금지
.env
.env.*
!.env.example
*.pem
*.key

# 측정 데이터
#
# 요청별 원본(requests.jsonl)과 집계(summary/meta)는 커밋한다.
# 리뷰어가 RNGD 없이도 planner 와 그래프를 전부 재현할 수 있어야 하기 때문이다.
#
# metrics 시계열만 제외한다. 1초 폴링이라 95MB 로 전체 용량의 82% 를 차지하는데,
# 이 파일이 없어도 재현되지 않는 것은 KV 사용률·대기열의 초 단위 추이뿐이다.
# 원본은 로컬 data/raw/ 에 그대로 남아 있다.
data/raw/**/metrics_timeseries.jsonl

# 개발 중 생긴 임시 산출물
data/raw/**/*.tmp

# 개발 중 사용한 테스트용 스크립트
tests/

# 굳이 공개할 필요 없는 폴더 및 파일
.claude/
pyproject.toml

# 호스팅 엔드포인트 dev run 은 커밋하지 않는다.
#
# 하네스 검증용으로 개발 머신에서 돌린 것이라 (a) capacity 계산에 쓸 수 없고
# (planner 가 로드 단계에서 거부한다) (b) meta.json 에 실행한 머신의 경로·이름이
# 남는다. 이 run 들에서 얻은 결론은 docs/03-api-findings.md 에 전부 정리돼 있다.
# 원본은 로컬 data/raw/ 에 그대로 보관한다.
data/raw/*_Qwen3-32B-FP8_*/
